{
    "upstream": {
        "owner": "wzxxcz",
        "repo": "wzxxcz",
        "branch": "maing",
        "path": "py"
    },
    "output": "接口.json",
    "accelerator": "https://gh-proxy.com/",
    "auto_key_prefix": "wzxxcz_",
    "preserve_api_prefixes": [
        "./"
    ],
    "preserve_non_http": true,
    "exclude_scripts": [],
    "exclude_names": [],
    "filters": {
        "require_spider_class": true,
        "dedupe_identical_scripts": true,
        "exclude_adult": true,
        "adult_keywords": [],
        "adult_title_keywords": [],
        "adult_allow": []
    },
    "functional": {
        "enabled": true,
        "report": "reports/functional-report.json",
        "min_score": 0,
        "keyword": "庆余年",
        "adult_probe_keywords": [
            "麻豆传媒",
            "被家长调教的女教师"
        ],
        "timeout": 30,
        "workers": 12,
        "stream_workers": 12
    },
    "quality": {
        "min_grade": "B",
        "drop_unverified": true,
        "min_bitrate_kbps": 800,
        "min_bpp": 0.035,
        "min_speed_ratio": 0.7,
        "max_startup_ms": 12000,
        "bitrate_thresholds": {
            "2160": 6000,
            "1440": 3500,
            "1080": 1600,
            "720": 920,
            "480": 600,
            "360": 400
        },
        "max_lines": 4,
        "bitrate_allow": [],
        "speed_allow": [],
        "line_prune": {
            "enabled": true,
            "dead_status_min": 0,
            "blacklist": {
                "华谊影视.py": ["F蓝光", "QQ蓝光"]
            }
        }
    },
    "local_spider_dir": "脚本",
    "safety": {
        "min_previous_ratio": 0.5,
        "max_download_failure_ratio": 0.2
    },
    "request": {
        "timeout": 10,
        "retries": 1,
        "workers": 20,
        "download_workers": 12,
        "accept_4xx": true,
        "accept_5xx": false,
        "max_hosts_per_script": 8,
        "max_fallback_hosts": 3
    }
}
